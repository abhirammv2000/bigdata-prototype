# Copy to .env and fill in GOOGLE_API_KEY. Everything else has sane defaults.
#
# .env is consumed by:
#   - scripts/deploy-gke.sh  (reads GOOGLE_API_KEY, injects it as a K8s Secret)
#   - docker/docker-compose.yml  (local full-stack via `env_file`)
#   - local `uvicorn backend.app.main:app` runs

# ── LLM: Google Gemini (via Google AI Studio API key) ─────
# Get a free key at https://aistudio.google.com
LLM_PROVIDER=vertex
GOOGLE_API_KEY=your-google-ai-studio-key-here
VERTEX_MODEL=gemini-2.5-flash

# Vertex AI (service-account auth) instead of an API key — leave blank when using GOOGLE_API_KEY
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# ── LLM: Ollama (optional local-only alternative) ─────────
# Set LLM_PROVIDER=ollama to use these instead of Gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Vector DB (ChromaDB, in-process) ─────────────────────
CHROMADB_MODE=local
CHROMADB_PERSIST_DIR=./.chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Airflow REST API (for log fetch + status sync) ───────
AIRFLOW_BASE_URL=http://localhost:8082
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# ── Lineage (Marquez) ───────────────────────────────────
MARQUEZ_URL=http://localhost:5000

# ── Storage ─────────────────────────────────────────────
# Set to a GCS bucket name to persist the ops snapshot in GCS; blank = local file
GCS_DATA_BUCKET=
